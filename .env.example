# API key Claude (wajib) — https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Kredensial Google service account (pilih salah satu):
# 1) Path ke file JSON service account
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
# 2) Atau isi JSON-nya langsung dalam satu baris
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Spreadsheet BIAYA & KAS LAUNDRY (tetap, tidak berganti bulan)
BIAYA_KAS_SPREADSHEET_ID=17FSDZKdYnn3yl08lWDfTZaQZ-x2AhXn493HhVnfAZlY

# Opsional: paksa ID spreadsheet CASHFLOW bulan ini (lewati auto-discovery)
# CASHFLOW_SPREADSHEET_ID=1ktHJouvvtlc1shMPWj9-hy_nINipuUw8PP_qdvG2wLk

# Zona waktu bisnis (Manado = WITA)
TZ_NAME=Asia/Makassar

PORT=3000

# --- Login dashboard (WAJIB diisi sebelum online) ---
# Username bebas (default "admin" bila dikosongkan) dan password rahasia Anda.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ganti-dengan-password-kuat
# Opsional: secret penanda-tangan sesi. Bila kosong, diturunkan otomatis dari
# username+password (sesi tetap valid selama keduanya tidak berubah).
# SESSION_SECRET=string-acak-panjang

